{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "*.ts"]
}
